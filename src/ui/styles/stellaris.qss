QWidget#MainWindow {
    background-color: rgb(35, 55, 50);
    color: rgb(35, 75, 70);
}

QWidget {
    background-color: rgb(35, 55, 50);
    color: rgb(35, 75, 70);
}

QFrame {
    color: rgb(67, 144, 134);
    background-color: rgb(35, 55, 50);
}

QPushButton {
    color: rgb(255, 255, 255);
    background-color: rgba(22, 59, 56, 100);
    /* border: 3px solid rgb(35, 75, 70); */
    border: 1px solid rgb(67, 144, 134);
    padding: 5px;
    text-align: center;
}

QPushButton:hover {
    background-color: rgba(255, 179, 25, 100);
    border-color: rgba(255, 151, 33, 175);
}

QPushButton:pressed {
    background-color: rgba(30, 80, 70, 100);
    /* border-color: rgb(67, 144, 134); */
    border-color: rgb(67, 144, 134);
}

QComboBox {
    color: rgb(255, 255, 255);
    background-color: rgba(22, 59, 56, 100);
    /* border: 4px solid rgb(35, 75, 70); */
    border: 1px solid rgb(67, 144, 134);
    padding: 3px;
}

QComboBox:hover {
    background-color: rgba(255, 179, 25, 100);
    border-color: rgba(255, 151, 33, 175);
}

QLineEdit {
    color: rgb(255, 255, 255);
    background-color: rgba(22, 59, 56, 100);
    border: 1px solid rgb(67, 144, 134);
    padding: 3px;
}

QCheckBox#StyledCheckbox1 {
    color: rgb(255, 255, 255);
    spacing: 10px;
    margin: 3px 0;
}

QCheckBox#StyledCheckbox1::indicator {
    width: 18px;
    height: 18px;
    padding: 2px;
    border: 1px solid rgb(67, 144, 134);
    background-color: rgba(22, 59, 56, 100);
    background-clip: content;
}

QCheckBox#StyledCheckbox1::indicator:hover {
    border-color: rgba(255, 151, 33, 175);
}

QCheckBox#StyledCheckbox1::indicator:checked {
    border-color: rgb(255, 179, 25);
    background-color: rgb(255, 179, 25);
}

QCheckBox#StyledCheckbox1::indicator:disabled {
    border-color: rgb(140, 140, 140);
}

QCheckBox#StyledCheckbox1::indicator:checked:disabled {
    border-color: rgb(140, 140, 140);
    background-color: rgb(140, 140, 140);
}

/* Required patches are disabled but still readable, without the grey disabled box */
QCheckBox#StyledCheckbox1:disabled {
    background-color: transparent;
    color: rgb(200, 200, 200);
}

QRadioButton {
    color: rgb(255, 255, 255);
    spacing: 10px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid rgb(67, 144, 134);
    border-radius: 9px;
    background-color: rgba(22, 59, 56, 100);
}

QRadioButton::indicator:hover {
    border-color: rgba(255, 151, 33, 175);
    background-color: rgba(255, 179, 25, 100);
}

QRadioButton::indicator:checked {
    border-color: rgb(255, 179, 25);
    background-color: qradialgradient(cx: 0.5,
        cy: 0.5,
        radius: 0.5,
        fx: 0.5,
        fy: 0.5,
        stop: 0 rgb(255, 179, 25),
        stop: 0.45 rgb(255, 179, 25),
        stop: 0.55 rgba(22, 59, 56, 100)
    );
}

QScrollArea {
    border: 1px solid rgb(67, 144, 134);
}

/* TitleLabel */
/* lbl_title and window_functions_container */
QLabel#TitleLabel,
QWdiget#WindowFunctionsContainer {
    color: rgb(255, 255, 255);
    background-color: rgb(35, 75, 70);
    border-radius: 5px;
}

/* SectionTitle */
QLabel#SectionTitle {
    color: rgb(255, 179, 25);
    background-color: rgb(35, 75, 70);
    border-radius: 5px;
}

/* WelcomeDialogTitleLabel */
QLabel#WelcomeDialogTitleLabel {
    color: rgb(255, 179, 25);
}

/* Description item */
QLabel#DescriptionLabel1 {
    color: rgb(220, 220, 220);
}

/* Small explanatory text under a field */
QLabel#HintLabel {
    color: rgb(224, 224, 224);
}

/* FieldNameLabel */
QLabel#FieldNameLabel {
    color: rgb(255, 255, 255);
}

/* Configure Button */
QPushButton#ConfigureButton {
    background-color: transparent;
    border: none;
    padding: 0px;
}

/* Button hover */
QPushButton#ConfigureButton:hover {
    background-color: rgba(255, 165, 0, 80);
}

/* Button is pressed */
QPushButton#ConfigureButton:pressed {
    background-color: rgba(255, 140, 0, 120);
}

/* ExitButton */
QPushButton#ExitButton {
    color: rgb(25, 255, 236);
    background-color: rgba(22, 59, 56, 100);
    border: 1px solid rgb(67, 144, 134);
}

QPushButton#ExitButton:hover {
    background-color: rgba(255, 179, 25, 100);
    border-color: rgba(255, 151, 33, 175);
}

QPushButton#ExitButton:pressed {
    background-color: rgba(30, 80, 70, 100);
    border-color: rgb(67, 144, 134);
}

/* FAQ Button */
QPushButton#FAQButton {
    color: rgb(25, 255, 236);
    background-color: rgba(22, 59, 56, 100);
    border: 1px solid rgb(67, 144, 134);
}

QPushButton#FAQButton:hover {
    background-color: rgba(255, 179, 25, 100);
    border-color: rgba(255, 151, 33, 175);
}

QPushButton#FAQButton:pressed {
    background-color: rgba(30, 80, 70, 100);
    border-color: rgb(67, 144, 134);
}

QPlainTextEdit#TerminalDisplay {
    /* color: rgb(255, 255, 255); */
    background-color: rgba(22, 59, 56, 100);
    /* border: 3px solid rgb(35, 75, 70); */
    border: 1px solid rgb(67, 144, 134);
}

QTextBrowser#ProjectLink {
    /* border: 4px solid rgb(35, 75, 70); */
    border: 1px solid rgb(67, 144, 134);
    background-color: rgba(22, 59, 56, 100);
    color: white;
}

QMenu::item {
    color: white;
}

/* ANY widget that is disabled */
QWidget:disabled {
    background-color: rgb(80, 80, 80);
    color: rgb(60, 60, 60);
    border-color: rgb(50, 50, 50);
}

QTabBar::tab {
    color: rgb(255, 255, 255);
}

/* Message boxes (text and "Show Details" box) */
QMessageBox QLabel,
QMessageBox QTextEdit {
    color: rgb(255, 255, 255);
}

/* Manage Save Backups dialog */
QDialog#SaveBackupsDialog QLabel,
QDialog#SaveBackupsDialog QTreeView,
QDialog#SaveBackupsDialog QHeaderView::section {
    color: rgb(255, 255, 255);
}

/* Store picker dialog */
QLabel#StorePickerText {
    color: rgb(255, 255, 255);
}

QLabel#StoreDescription {
    color: rgb(225, 225, 225);
    background-color: rgb(35, 75, 70);
    border-radius: 5px;
}

/* Save review dialog: finding values coloured by status */
QLabel#FindingValue {
    color: rgb(255, 255, 255);
}

QLabel#FindingValue[status="ok"] {
    color: rgb(120, 220, 140);
}

QLabel#FindingValue[status="attention"] {
    color: rgb(255, 179, 25);
}

/* Option picker dialog */
QLabel#OptionPickerText {
    color: rgb(255, 255, 255);
}

QListWidget#OptionPickerList {
    color: rgb(255, 255, 255);
    background-color: rgba(22, 59, 56, 100);
    border: 1px solid rgb(67, 144, 134);
    padding: 3px;
}

QListWidget#OptionPickerList::item {
    padding: 6px;
}

QListWidget#OptionPickerList::item:hover {
    background-color: rgba(255, 179, 25, 60);
}

QListWidget#OptionPickerList::item:selected {
    color: rgb(255, 255, 255);
    background-color: rgba(255, 179, 25, 120);
}

/* Patch Progress Bar */
QProgressBar#PatchProgressBar {
    color: rgb(255, 255, 255); /* Text inside */
    background-color: rgba(22, 59, 56, 100);
    border: 1px solid rgb(67, 144, 134);
    text-align: center;
    min-height: 20px;
}

QProgressBar#PatchProgressBar::chunk {
    background-color: rgba(255, 179, 25, 150);  /* Orange fill */
}

/* Markdown text: message, FAQ */
QTextBrowser#MarkdownText {
    border: 1px solid rgb(67, 144, 134);
    background-color: rgba(22, 59, 56, 100);
    color: white;
    font-size: 14px;
    qproperty-headerColor: rgb(235, 188, 61);
    qproperty-subheaderColor: rgb(23, 147, 97);
    qproperty-linkColor: rgb(25, 255, 236);
}